{
  "manifest_version": 3,
  "name": "Morphogrammer",
  "version": "3.0.0",
  "description": "Заменяет выделенный текст по пользовательской таблице замен с приоритетом столбцов (латиница, греческий, иврит, цифры, Unicode).",
  
  "browser_specific_settings": {
    "gecko": {
      "strict_min_version": "140.0",
      "id": "alex.rex@gmail.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Morphogrammer — настройки",
    "default_popup": "popup.html"
  },
  "options_page": "settings.html",
  "commands": {
    "transform-selection": {
      "suggested_key": {
        "default": "Alt+Shift+M",
        "mac": "Alt+Shift+M"
      },
      "description": "Преобразовать выделенный текст"
    }
  },
  "icons": {
    "48": "icons/icon48.png"
  }
}